# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage)
*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb
*.log
*.err
*-logcat.txt

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Mobile development
android-sdk/

# Environment files
*.env
*.env.*

# ─── SENSITIVE / LARGE FILES ──────────────────────────────────────────────────

# Firebase & Google secrets — never push these
google-services.json
GoogleService-Info.plist
firebase-users-export.json

# APK / release builds — use GitHub Releases or EAS instead
releases/
**/*.apk
**/*.aab

# Test reports, screenshots, and QA artifacts
test_reports/
frontend/metro.err

# Playwright test artifacts
frontend/playwright-report/
frontend/test-results/

# Test/debug screenshots & UI dumps scattered in frontend root
frontend/admin-*.png
frontend/admin-*.xml
frontend/android-*.png
frontend/android-*.xml
frontend/age-filled.png
frontend/*.txt
frontend/*.xml
frontend/final-*.png
frontend/final-*.xml
frontend/fallback-*.png
frontend/password-*.xml
frontend/debug.js

# Wrangler (Cloudflare Workers) config — may contain secrets
frontend/wrangler.jsonc
