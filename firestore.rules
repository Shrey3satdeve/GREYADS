rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper functions
    // -----------------------------------------------------------------------

    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Check if user is the direct owner of a document
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Role-based access helpers — these perform a cross-document read to the user's profile
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isAuth() && getUserData().role == 'admin';
    }
    function isStaff() {
      return isAuth() && (getUserData().role == 'staff' || getUserData().role == 'admin');
    }

    // -----------------------------------------------------------------------
    // users collection
    // -----------------------------------------------------------------------
    match /users/{userId} {
      // Owners and Admins can read user profiles
      allow read: if isOwner(userId) || isAdmin();

      // Users can update safe fields on their own profiles.
      // Admin role must be verified to update any profile (including roles).
      allow update: if (isOwner(userId) && 
                      !('role' in request.resource.data) && 
                      !('is_revoked' in request.resource.data)) || isAdmin();

      // New users provisioned as 'user' only with strict size limits
      allow create: if isOwner(userId) && 
                      request.resource.data.role == 'user' &&
                      request.resource.data.name is string &&
                      request.resource.data.name.size() > 1 &&
                      request.resource.data.name.size() < 100 &&
                      (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() < 20));
    }

    // -----------------------------------------------------------------------
    // events collection
    // -----------------------------------------------------------------------
    match /events/{eventId} {
      // Browsing events is public for authenticated users
      allow read: if isAuth();

      // Only Admins can manage events with strict validation
      allow write: if isAdmin() &&
                     request.resource.data.title is string &&
                     request.resource.data.title.size() < 200 &&
                     request.resource.data.description is string &&
                     request.resource.data.description.size() < 2000 &&
                     request.resource.data.price is number;
    }

    // -----------------------------------------------------------------------
    // tickets collection
    // -----------------------------------------------------------------------
    match /tickets/{ticketId} {
      // Owners, Staff (for scanning), and Admins can read tickets
      allow read: if isAuth() && (request.auth.uid == resource.data.user_id || isStaff());

      // Tickets are created exclusively by Cloud Functions — client writes are forbidden
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // notifications collection
    // -----------------------------------------------------------------------
    match /notifications/{notifId} {
      // Personal notifications: read/write by owner only
      allow read: if isAuth() && request.auth.uid == resource.data.user_id;
      allow update, delete: if isAuth() && request.auth.uid == resource.data.user_id;

      // Creation is server-only (via onDocumentCreated trigger)
      allow create: if false;
    }

    // -----------------------------------------------------------------------
    // broadcasts collection
    // -----------------------------------------------------------------------
    match /broadcasts/{broadcastId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // scan_logs collection
    // -----------------------------------------------------------------------
    match /scan_logs/{logId} {
      // Only Staff and Admins can view scan history
      allow read: if isStaff();

      // Writing of scan logs is server-only (via api.post('/scanner/verify'))
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Default Deny
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
