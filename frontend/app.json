{
  "expo": {
    "name": "GreyAdz",
    "slug": "GreyAdz",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/images/greyadz-logo-v3.png",
    "scheme": "greyadz-payment",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greyadz.userapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes to verify event tickets",
        "NSPhotoLibraryUsageDescription": "Save ticket QR codes to your photos"
      }
    },
    "android": {
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/greyadz-logo-v3.png",
        "backgroundColor": "#000000"
      },
      "package": "com.greyadz.userapp",
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "greyadz-payment"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/greyadz-logo-v3.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31611dba-ea52-4077-b195-62125452408f"
      }
    }
  }
}
