{
  "expo": {
    "name": "GreyAdz",
    "slug": "GreyAdz",
    "version": "1.0.36",
    "orientation": "portrait",
    "icon": "./assets/images/splash_logo.png",
    "scheme": "greyadz-payment",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greyadz.userapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes to verify event tickets",
        "NSPhotoLibraryUsageDescription": "Save ticket QR codes to your photos"
      }
    },
    "android": {
      "versionCode": 37,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#000000"
      },
      "package": "com.greyadz.userapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "greyadz-payment"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash_logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildToolsVersion": "35.0.0",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "kotlinVersion": "1.9.25",
            "ndkVersion": "26.1.10909125",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "googleClientId": "420509611534-7km6iakrkkte4e43ht6pktr3uc1au1vh.apps.googleusercontent.com",
      "eas": {
        "projectId": "31611dba-ea52-4077-b195-62125452408f"
      }
    }
  }
}
